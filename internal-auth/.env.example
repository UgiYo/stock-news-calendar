# Replace DNS with the LDAP certificate SAN; do not use unvalidated TLS.
LDAP_HOST=REPLACE_WITH_LDAP_CERTIFICATE_DNS
LDAP_PORT=3269
LDAP_TLS_MODE=ldaps
LDAP_CA_FILE=/secrets/company-ca.pem
LDAP_BASE_DN=DC=umc,DC=com
# Confirm format with IT: {username}@UPN_SUFFIX or DOMAIN\{username}
LDAP_LOGIN_TEMPLATE={username}@REPLACE_WITH_UPN_SUFFIX
LDAP_ALLOWED_GROUP_DN=REPLACE_WITH_GROUP_DN
LDAP_ALLOW_ALL_USERS=false
INTERNAL_LOGIN_URL=https://REPLACE_WITH_INTERNAL_HOST/login
COMPANY_ISSUER=urn:stock-news-calendar:company
WORKER_ORIGIN=https://REPLACE_WITH_WORKER_HOST
APP_URL=https://ugiyo.github.io/stock-news-calendar/
WORKER_REQUEST_JWKS_FILE=/secrets/worker-request-public.jwks.json
COMPANY_SIGNING_KEY_FILE=/secrets/company-signing-private.pem
COMPANY_SIGNING_KID=company-v1
FLASK_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
RATE_DB=/data/rate-limits.sqlite
